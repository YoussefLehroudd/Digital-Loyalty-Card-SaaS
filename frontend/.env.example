# Vercel / Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Existing Laravel API fallback while endpoints are being migrated to Next API routes.
# For full Vercel backend migration, prefer relative /api endpoints.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Neon PostgreSQL. Use the pooled connection string for Vercel runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Use an unpooled/direct Neon URL only for migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
