# Vercel / Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API base URL.
# Leave empty in Vercel/local Next.js so requests use the built-in Node API routes at /api.
# Only set this if you intentionally point the frontend to another API host.
NEXT_PUBLIC_API_URL=/api

# Neon PostgreSQL. Use the pooled connection string for Vercel runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Use an unpooled/direct Neon URL only for one-off database maintenance when needed.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# Cloudinary uploads
CLOUDINARY_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password reset email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLIENT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
